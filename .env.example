# ==============================================================================
# Smart Expense Tracker & Budget Management System - Environment Variables
# ==============================================================================

# Supabase Configuration
# Obtain these from your Supabase Project Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Backend REST API URL (use /api in local Vite full-stack or full URL in production)
VITE_API_BASE_URL="/api"

# Backend Server Configuration (for Render or Node.js deployment)
PORT=3000
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"
CLIENT_URL="http://localhost:3000"

# Optional Gemini API Key (if provided by environment)
GEMINI_API_KEY=""
APP_URL=""
